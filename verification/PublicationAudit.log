TwoStateQuantumEmbedding.OptimalDrift.explicit_endpoint_output : ∀ (h : TwoStateQuantumEmbedding.GKSLAlgebra.BlochVec)
  (S : TwoState.GeneralGeometry.M3),
  Matrix.PosSemidef S →
    0 < TwoStateQuantumEmbedding.CanonicalBias.fixedZ h S →
      ∀ (sign : ℝ),
        |sign| ≤ 1 →
          have c :=
            TwoStateQuantumEmbedding.OptimalDrift.endpoint S
              (TwoStateQuantumEmbedding.AffineExponential.biasFunctional
                (TwoStateQuantumEmbedding.CanonicalBias.fixedMatrix h S))
              sign;
          Matrix.PosSemidef (TwoState.GeneralGeometry.physicalCanonical S c) ∧
            TwoStateQuantumEmbedding.CanonicalBloch.canonicalOutput h (TwoState.GeneralGeometry.physicalCanonical S c)
                1 =
              TwoStateQuantumEmbedding.CanonicalBias.outputFromXZ (TwoStateQuantumEmbedding.CanonicalBias.fixedX h S)
                (sign * TwoStateQuantumEmbedding.CanonicalBias.fixedZ h S)

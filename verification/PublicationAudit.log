TwoStateQuantumEmbedding.ActualSwapSystem.actual_planar_analytic_stationary_branch :
  ∃ ψ U V,
    IsOpen U ∧
      0 ∈ U ∧
        IsOpen V ∧
          TwoStateQuantumEmbedding.ActualSwapSystem.baseParameters ∈ V ∧
            ψ 0 = TwoStateQuantumEmbedding.ActualSwapSystem.baseParameters ∧
              AnalyticOnNhd ℝ ψ U ∧
                Set.MapsTo ψ U V ∧
                  Set.MapsTo (⇑TwoStateQuantumEmbedding.ActualSwapSystem.reflectParameters) V V ∧
                    (∀ k ∈ U, TwoStateQuantumEmbedding.ActualSwapSystem.stationarity (k, ψ k) = 0) ∧
                      (∀ k ∈ U, ∀ y ∈ V, TwoStateQuantumEmbedding.ActualSwapSystem.stationarity (k, y) = 0 ↔ ψ k = y) ∧
                        ∀ k ∈ U, TwoStateQuantumEmbedding.ActualSwapSystem.Planar (ψ k)

TwoStateQuantumEmbedding.OriginalProblem.original_Q2_four_entry_iff : ∀ (p : ℝ × ℝ),
  p ∈ TwoStateQuantumEmbedding.Q2 ↔
    ∀ (δ : ℝ),
      0 < δ →
        ∃ n H A t,
          Matrix.IsHermitian H ∧
            0 ≤ t ∧
              ∀ (i j : Fin 2),
                |TwoStateQuantumEmbedding.OriginalProblem.table p i j -
                      TwoStateQuantumEmbedding.OriginalProblem.probability H A t i j| ≤
                  δ

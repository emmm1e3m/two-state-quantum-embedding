TwoStateQuantumEmbedding.ResetFamily.reset_every_small_epsilon_uniform :
  ∃ C > 0,
    ∃ ε₀ > 0,
      ∀ ε ∈ Set.Ioo 0 ε₀,
        ∃ L a,
          2 < L ∧
            1 < TwoStateQuantumEmbedding.ResetFamily.curveA L ∧
              0 < TwoStateQuantumEmbedding.ResetFamily.curveTime L ∧
                (∀ (μ : Fin 1), Matrix.rank (TwoStateQuantumEmbedding.ResetFamily.unitJumps L μ) = 1) ∧
                  TwoStateQuantumEmbedding.finiteOutput 0 (TwoStateQuantumEmbedding.ResetFamily.unitJumps L) 1 =
                      (a, 1 - ε) ∧
                    (a, 1 - ε) ∈ TwoStateQuantumEmbedding.finiteOutputs ∧
                      0 < a ∧
                        a < ε ∧
                          |a / ε - (1 - 4 / Real.exp 1 / Real.log (1 / ε))| ≤
                            C * (Real.log (Real.log (1 / ε)) / Real.log (1 / ε) ^ 2)

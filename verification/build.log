  (h : TwoStateQuantumEmbedding.GKSLAlgebra.BlochVec) (K : TwoStateQuantumEmbedding.CanonicalGradient.KMatrix),
  PosSemidef K →
    (TwoStateQuantumEmbedding.CanonicalGradient.kDerivative (1 / 2) (-1 / 2) (h, K)) K ≠ 0 →
      ∀ (b : ℝ),
        TwoStateQuantumEmbedding.CanonicalBloch.canonicalOutput h K 1 = (TwoStateQuantumEmbedding.lowerBoundary b, b) →
          TwoStateQuantumEmbedding.CanonicalGradient.hGradient
              ((1 - TwoStateQuantumEmbedding.CanonicalStationarity.multiplier h K) / 2)
              ((1 + TwoStateQuantumEmbedding.CanonicalStationarity.multiplier h K) / 2) (h, K) =
            0 :=
⋯
info: TwoStateQuantumEmbedding/CanonicalStationarity.lean:414:0: theorem TwoStateQuantumEmbedding.CanonicalStationarity.canonical_kkt_of_lowerBoundary : ∀
  (h : TwoStateQuantumEmbedding.GKSLAlgebra.BlochVec) (K : TwoStateQuantumEmbedding.CanonicalGradient.KMatrix),
  PosSemidef K →
    (TwoStateQuantumEmbedding.CanonicalGradient.kDerivative (1 / 2) (-1 / 2) (h, K)) K ≠ 0 →
      ∀ (b : ℝ),
        TwoStateQuantumEmbedding.CanonicalBloch.canonicalOutput h K 1 = (TwoStateQuantumEmbedding.lowerBoundary b, b) →
          have μ := TwoStateQuantumEmbedding.CanonicalStationarity.multiplier h K;
          have S :=
            TwoStateQuantumEmbedding.CanonicalGradient.kGradient (1 / 2) (1 / 2) (h, K) -
              μ • TwoStateQuantumEmbedding.CanonicalGradient.kGradient (1 / 2) (-1 / 2) (h, K);
          TwoStateQuantumEmbedding.CanonicalGradient.hGradient ((1 - μ) / 2) ((1 + μ) / 2) (h, K) = 0 ∧
            PosSemidef S ∧ (S * K).trace.re = 0 ∧ S * K = 0 :=
⋯
info: TwoStateQuantumEmbedding/CanonicalStationarity.lean:415:0: theorem TwoStateQuantumEmbedding.ActualSwapOptimality.stationarity_chart_of_lowerBoundary : ∀
  (h : TwoStateQuantumEmbedding.GKSLAlgebra.BlochVec) (K : TwoStateQuantumEmbedding.CanonicalGradient.KMatrix),
  h 1 = 0 →
    PosSemidef K →
      rank K = 1 →
        0 < TwoStateQuantumEmbedding.RankOneChart.scale K →

            ∀ (b : ℝ),
              TwoStateQuantumEmbedding.CanonicalBloch.canonicalOutput h K 1 =
                  (TwoStateQuantumEmbedding.lowerBoundary b, b) →
                TwoStateQuantumEmbedding.ActualSwapSystem.stationarity
                    (TwoStateQuantumEmbedding.RankOneChart.scale K,
                      TwoStateQuantumEmbedding.RankOneChart.parameters (h 0) (h 2 / 2)
                        (TwoStateQuantumEmbedding.CanonicalStationarity.multiplier h K)
                        (TwoStateQuantumEmbedding.RankOneChart.chart K)) =
                  0 :=
⋯
